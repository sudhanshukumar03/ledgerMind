# Frontend (Next.js) environment.
# Copy to .env.local for local development. Only NEXT_PUBLIC_* vars are exposed
# to the browser — never put secrets here.

# Base URL of the backend API, including the /api/v1 prefix. Must match the
# backend PORT and global prefix (see backend main.ts setGlobalPrefix).
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Model name shown in the AI Controller UI. Cosmetic only — the backend's
# AI_MODEL is what actually drives Groq calls. Keep the two in sync.
NEXT_PUBLIC_AI_MODEL=openai/gpt-oss-120b
