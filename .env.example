# ── Server ─────────────────────────────────────────────
PORT=3001
# development | production. Set to "production" on deploy: this enables the
# proxy-aware client IP (see TRUST_PROXY) and enforces FRONTEND_URL for CORS.
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ── Database (matches docker-compose.yml) ──────────────
DATABASE_URL=postgresql://ledgermind:ledgermind@localhost:5432/ledgermind?schema=public

# ── Redis (BullMQ + rate-limit storage) ────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Auth ───────────────────────────────────────────────
# MUST be at least 32 characters — the app refuses to boot otherwise
# (see app.module.ts). Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
JWT_EXPIRES_IN=1d

# ── AI (Groq, OpenAI-compatible) ───────────────────────
GROQ_API_KEY=your_groq_api_key
# Model availability depends on your Groq plan. If a model 404s with
# "model_not_found", pick one your key actually lists:
#   curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
# Verified working on the limited/free tier: openai/gpt-oss-120b (tool calling +
# JSON), openai/gpt-oss-20b (faster). llama-3.3-70b-versatile needs a plan that
# grants it.
AI_MODEL=openai/gpt-oss-120b

# ── Razorpay ───────────────────────────────────────────
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ── Actions / Policy ───────────────────────────────────
# Refunds at or below this amount (in paise) auto-approve; above requires admin.
AUTO_APPROVE_BELOW_AMOUNT=1000

# ── Rate limiting / DDoS ───────────────────────────────
# How Express derives the client IP for rate limiting. Leave unset to default
# from NODE_ENV (true in production, false otherwise). Behind a known reverse
# proxy/CDN set the number of proxy hops (e.g. 1) or "true"; direct-to-Node
# deployments should keep it false so X-Forwarded-For can't be spoofed.
TRUST_PROXY=
# Route-agnostic hard cap of requests per IP per minute across the WHOLE API
# (defaults to 300). Raise it if the API is fronted by shared NAT/VPN egress.
THROTTLE_IP_GLOBAL=300

# ── Demo ───────────────────────────────────────────────
# Optional: pin the merchant used by the bank-data generator script.
# Falls back to the first merchant in the DB (run `npx prisma db seed` first).
DEMO_MERCHANT_ID=
