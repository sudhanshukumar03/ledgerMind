# Local backend; Compose publishes Redis on host 6380.
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
DATABASE_URL=postgresql://ledgermind:ledgermind@localhost:5432/ledgermind?schema=public
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=learning-redis-password
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=1d
TRUST_PROXY=false
THROTTLE_IP_GLOBAL=300

# AI is optional. Choose a model available to your account.
AI_ENABLED=false
GROQ_API_KEY=
AI_MODEL=llama-3.3-70b-versatile

# disabled | simulation | provider_test; provider_test requires rzp_test_ credentials.
PAYMENT_EXECUTION_MODE=simulation
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=replace-with-a-local-test-secret
WEBHOOK_MAX_EVENT_AGE_MS=86400000

# Explicit destructive reset only. Must name the exact disposable database.
ALLOW_DEMO_RESET=false
DEMO_RESET_DATABASE=
TEST_ALLOW_DATABASE_RESET=false
DEMO_MERCHANT_ID=
