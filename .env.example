# ── Server ─────────────────────────────────────────────
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ── Database (matches docker-compose.yml) ──────────────
DATABASE_URL=postgresql://ledgermind:ledgermind@localhost:5432/ledgermind?schema=public

# ── Redis (BullMQ) ─────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Auth ───────────────────────────────────────────────
JWT_SECRET=super-secret-jwt-key
JWT_EXPIRES_IN=1d

# ── AI (Groq, OpenAI-compatible) ───────────────────────
GROQ_API_KEY=your_groq_api_key
AI_MODEL=llama-3.3-70b-versatile

# ── Razorpay ───────────────────────────────────────────
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ── Actions / Policy ───────────────────────────────────
# Refunds at or below this amount (in paise) auto-approve; above requires admin.
AUTO_APPROVE_BELOW_AMOUNT=1000

# ── Demo ───────────────────────────────────────────────
DEMO_MERCHANT_ID=
