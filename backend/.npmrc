# nestjs-zod@5.5.0 (latest) declares a peer of @nestjs/common ^10 || ^11, but
# this project runs NestJS 12. The library works fine on 12 — the peer range is
# just stale upstream. Accept the mismatch so installs and `npm audit fix` are
# reproducible without a manual --legacy-peer-deps flag each time.
legacy-peer-deps=true
